# Must match the backend's actual BACKEND_HOST:BACKEND_PORT (repo-root
# .env, default 127.0.0.1:8080) -- NOT Chroma's port, which also defaults
# to 8000 and is a different service entirely. Check the backend's own
# .env before assuming this default is right; on a machine where 8080 is
# already taken, BACKEND_PORT (and this value) will differ.
VITE_API_BASE=http://localhost:8080
